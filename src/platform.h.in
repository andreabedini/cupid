/*
 * @configure_input@
 * Operating system and architecture names, in the spellings the Haskell
 * libraries and the C sources test for.  Generated by meson.  This header
 * is also run through cpphs over Haskell sources, so it must not rely on
 * compiler-defined macros; the values come from the build configuration.
 */
#ifndef __PLATFORM_H__
#define __PLATFORM_H__

#define HostPlatform   @HOST_PLATFORM_CPP@
#define TargetPlatform @HOST_PLATFORM_CPP@
#define BuildPlatform  @HOST_PLATFORM_CPP@

/* Definitions suitable for use in CPP conditionals */
#define @HOST_PLATFORM_CPP@_HOST 1
#define @HOST_PLATFORM_CPP@_TARGET 1
#define @HOST_PLATFORM_CPP@_BUILD 1

#define @HOST_ARCH@_HOST_ARCH 1
#define @HOST_ARCH@_TARGET_ARCH 1
#define @HOST_ARCH@_BUILD_ARCH 1

#define @HOST_OS@_HOST_OS 1
#define @HOST_OS@_TARGET_OS 1
#define @HOST_OS@_BUILD_OS 1

/* Definitions of strings for use in C or Haskell code */
#define HOST_ARCH	"@HOST_ARCH@"
#define TARGET_ARCH	"@HOST_ARCH@"
#define BUILD_ARCH	"@HOST_ARCH@"

#define HOST_OS		"@HOST_OS@"
#define TARGET_OS	"@HOST_OS@"
#define BUILD_OS	"@HOST_OS@"

#endif /* __PLATFORM_H__ */
