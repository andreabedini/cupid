Main> -- type constructor
data Shape a

-- constructors:
Circle :: a -> Shape a
Rect :: a -> a -> Shape a
Named :: String -> Shape a -> Shape a
Strict :: Int -> a -> Shape a
Nil :: Shape a
Unit :: Shape a
(:+:) :: Shape a -> Shape a -> Shape a
-- selectors:
label :: Shape a -> String
inner :: Shape a -> Shape a

-- instances:
instance Show a => Show (Shape a)

