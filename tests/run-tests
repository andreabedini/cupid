#!/usr/bin/env python3
"""Run the regression tests under tests/.

usage: run-tests CUPID RUNCUPID PACKAGES TESTDIR [NAME...]

Every NAME.hs in TESTDIR is one test (all of them when no NAME is given).
The files that go with it, all optional except NAME.stdout:

  NAME.stdout   the exact output expected (stdout and stderr together)
  NAME.stdin    if present, the test is a REPL session: NAME.hs is loaded
                into `cupid +q`, NAME.stdin is fed to the prompt and the
                banner is dropped from the output; otherwise NAME.hs is
                run with runcupid
  NAME.args     extra command-line options, one shell word per line
  NAME.env      environment changes, one per line: VAR=VALUE sets,
                -VAR unsets
  NAME.exit     the expected exit status (default 0)
  NAME.stack    a C stack limit in kilobytes; POSIX only, as Windows fixes
                the stack when the program is linked, so on Windows the
                test is skipped, and reported as such

Each test runs with TMPDIR set to a fresh, empty directory of its own,
removed when the test is over.  A test that writes a file puts it there,
through System.Directory.getTemporaryDirectory, which reads TMPDIR: the
tests run with this directory as their working directory, and two suites
running at once -- check-configurations builds and tests configurations
side by side -- would otherwise create and delete the same files in it.
NAME.env may still set TMPDIR to something else.

A test passes when the output and the exit status both match.  A process
killed by a signal never matches, so a crash is always a failure.

No build option changes what the interpreter prints, so one expected
output serves every configuration as it is.

The banner is always dropped from a REPL session, whether or not the
"Type :? for help" line that normally ends it was reached: a module that
fails to load reports the failure before it.
"""

import os
import re
import subprocess
import sys
import tempfile

try:
    import resource  # POSIX only
except ImportError:
    resource = None

# The banner, with the help line that usually but not always follows it.
BANNER = re.compile(
    r"\ACupid [^\n]*\n"
    r"Derived from Hugs 98[^\n]*\n"
    r"the Yale Haskell Group[^\n]*\n\n"
    r"(?:Type :\? for help\n)?")

def read(path, default=None):
    try:
        with open(path, encoding="utf-8") as f:
            return f.read()
    except FileNotFoundError:
        return default


def run_one(cupid, runcupid, packages, testdir, name):
    base = os.path.join(testdir, name)
    expected = read(base + ".stdout")
    if expected is None:
        return False, "missing " + name + ".stdout"
    args = [a for a in (read(base + ".args") or "").splitlines() if a]
    stdin = read(base + ".stdin")
    exit_code = int((read(base + ".exit") or "0").strip())
    stack_kb = read(base + ".stack")
    if stack_kb and resource is None:
        return None, "cannot limit the C stack on this platform"

    # A private, empty TMPDIR for the test, gone when it is; see the top.
    with tempfile.TemporaryDirectory(prefix=name + ".") as scratch:
        env = dict(os.environ, TMPDIR=scratch)
        for line in (read(base + ".env") or "").splitlines():
            if line.startswith("-"):
                env.pop(line[1:], None)
            elif "=" in line:
                var, value = line.split("=", 1)
                env[var] = value

        if stdin is None:
            cmd = [runcupid, "-P" + packages] + args + [name + ".hs"]
        else:
            cmd = [cupid, "+q", "-P" + packages] + args + [name + ".hs"]

        def limit_stack():
            if stack_kb:
                kb = int(stack_kb.strip()) * 1024
                resource.setrlimit(resource.RLIMIT_STACK, (kb, kb))

        try:
            proc = subprocess.run(
                cmd, cwd=testdir, env=env, input=stdin,
                stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                encoding="utf-8", errors="replace", timeout=120,
                preexec_fn=limit_stack if stack_kb else None)
        except subprocess.TimeoutExpired:
            return False, "timed out"

    out = proc.stdout.replace("\r\n", "\n")
    if stdin is not None:
        # Drop the banner, which carries the version string.  Match it rather
        # than searching for the line that ends it: that line is not printed
        # when a module named on the command line fails to load, and a find()
        # that returns -1 used to cut fourteen characters off the real output.
        out = BANNER.sub("", out, count=1)
    problems = []
    if proc.returncode < 0:
        problems.append("killed by signal %d" % -proc.returncode)
    elif proc.returncode != exit_code:
        problems.append("exit status %d, expected %d"
                        % (proc.returncode, exit_code))
    if out != expected:
        problems.append("output differs:\n--- expected\n%s--- got\n%s"
                        % (expected, out))
    return not problems, "; ".join(problems)


def main(argv):
    if len(argv) < 5:
        sys.exit(__doc__)
    cupid, runcupid, packages, testdir = [os.path.abspath(a) for a in argv[1:5]]
    names = argv[5:] or sorted(
        f[:-3] for f in os.listdir(testdir) if f.endswith(".hs"))
    failed = skipped = 0
    for name in names:
        ok, detail = run_one(cupid, runcupid, packages, testdir, name)
        if ok is None:
            skipped += 1
            print("SKIP " + name + ": " + detail)
            continue
        print(("PASS " if ok else "FAIL ") + name)
        if not ok:
            failed += 1
            print("  " + detail.replace("\n", "\n  "))
    if skipped:
        print("%d tests, %d failed, %d skipped" % (len(names), failed, skipped))
    else:
        print("%d tests, %d failed" % (len(names), failed))
    sys.exit(1 if failed else 0)


if __name__ == "__main__":
    main(sys.argv)
