#!/usr/bin/env python3
"""Run the regression tests under tests/.

usage: run-tests CUDDLES RUNCUDDLES PACKAGES TESTDIR [NAME...]

Every NAME.hs in TESTDIR is one test (all of them when no NAME is given).
The files that go with it, all optional except NAME.stdout:

  NAME.stdout   the exact output expected (stdout and stderr together)
  NAME.stdin    if present, the test is a REPL session: NAME.hs is loaded
                into `cuddles +q`, NAME.stdin is fed to the prompt and the
                banner is dropped from the output; otherwise NAME.hs is
                run with runcuddles
  NAME.args     extra command-line options, one shell word per line
  NAME.env      environment changes, one per line: VAR=VALUE sets,
                -VAR unsets
  NAME.exit     the expected exit status (default 0)
  NAME.stack    a C stack limit in kilobytes (POSIX only)

A test passes when the output and the exit status both match.  A process
killed by a signal never matches, so a crash is always a failure.
"""

import os
import resource
import subprocess
import sys

BANNER_END = "Type :? for help\n"


def read(path, default=None):
    try:
        with open(path, encoding="utf-8") as f:
            return f.read()
    except FileNotFoundError:
        return default


def run_one(cuddles, runcuddles, packages, testdir, name):
    base = os.path.join(testdir, name)
    expected = read(base + ".stdout")
    if expected is None:
        return False, "missing " + name + ".stdout"
    args = [a for a in (read(base + ".args") or "").splitlines() if a]
    stdin = read(base + ".stdin")
    exit_code = int((read(base + ".exit") or "0").strip())
    stack_kb = read(base + ".stack")

    env = dict(os.environ)
    for line in (read(base + ".env") or "").splitlines():
        if line.startswith("-"):
            env.pop(line[1:], None)
        elif "=" in line:
            var, value = line.split("=", 1)
            env[var] = value

    if stdin is None:
        cmd = [runcuddles, "-P" + packages] + args + [name + ".hs"]
    else:
        cmd = [cuddles, "+q", "-P" + packages] + args + [name + ".hs"]

    def limit_stack():
        if stack_kb:
            kb = int(stack_kb.strip()) * 1024
            resource.setrlimit(resource.RLIMIT_STACK, (kb, kb))

    try:
        proc = subprocess.run(
            cmd, cwd=testdir, env=env, input=stdin,
            stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
            encoding="utf-8", errors="replace", timeout=120,
            preexec_fn=limit_stack if stack_kb else None)
    except subprocess.TimeoutExpired:
        return False, "timed out"

    out = proc.stdout.replace("\r\n", "\n")
    if stdin is not None:
        # Drop the banner, which carries the version string
        out = out[out.find(BANNER_END) + len(BANNER_END):]
    problems = []
    if proc.returncode < 0:
        problems.append("killed by signal %d" % -proc.returncode)
    elif proc.returncode != exit_code:
        problems.append("exit status %d, expected %d"
                        % (proc.returncode, exit_code))
    if out != expected:
        problems.append("output differs:\n--- expected\n%s--- got\n%s"
                        % (expected, out))
    return not problems, "; ".join(problems)


def main(argv):
    if len(argv) < 5:
        sys.exit(__doc__)
    cuddles, runcuddles, packages, testdir = [os.path.abspath(a) for a in argv[1:5]]
    names = argv[5:] or sorted(
        f[:-3] for f in os.listdir(testdir) if f.endswith(".hs"))
    failed = 0
    for name in names:
        ok, detail = run_one(cuddles, runcuddles, packages, testdir, name)
        print(("PASS " if ok else "FAIL ") + name)
        if not ok:
            failed += 1
            print("  " + detail.replace("\n", "\n  "))
    print("%d tests, %d failed" % (len(names), failed))
    sys.exit(1 if failed else 0)


if __name__ == "__main__":
    main(sys.argv)
