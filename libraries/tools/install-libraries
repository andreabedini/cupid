#!/bin/sh
# meson install script: copy the built Cupid libraries into cupiddir.
#
# usage: install-libraries BUILT_CUPIDDIR CUPIDDIR
#
# meson sets DESTDIR when staging an install; CUPIDDIR is the final
# absolute path.  Everything under packages/ is installed except the C
# sources, which are only needed to build the FFI stubs.

set -e

src=$1
dest="${DESTDIR}$2"

if [ ! -d "$src/packages" ]; then
	echo "$0: $src does not contain built libraries; run the build first" >&2
	exit 1
fi

echo "Installing Cupid libraries to $dest"
(cd "$src" && find packages -type f -print) | while read file
do
	case $file in
	*.c|*.h)	continue ;;
	esac
	mkdir -p "$dest/`dirname "$file"`"
	cp "$src/$file" "$dest/$file"
	chmod 644 "$dest/$file"
done
