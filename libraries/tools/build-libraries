#!/usr/bin/env python3
"""Assemble the Cupid libraries in the build directory.

usage: build-libraries SRCROOT OUT FFICUPID MKSYSCONFIG PLATFORM_DIR SYSTEM STAMP

The library sources under libraries/ are plain Haskell that Cupid owns,
so building them means copying them into OUT/packages,
generating the two platform-dependent files with mksysconfig, and running
fficupid over the modules that contain foreign imports to build their C
stubs.  OUT is what gets installed as cupiddir.

SYSTEM is the operating system the libraries are for, as meson names it
(host_machine.system()).  On Windows, the modules under libraries/windows
replace the ones of the same name, and the modules that only make sense
on a POSIX system are left out.
"""
import os
import re
import shutil
import subprocess
import sys

PACKAGES = ["cupid", "base"]

# Modules with foreign imports, in dependency order: fficupid loads a
# module's imports, so a module's stub must exist before the modules that
# import it are compiled.  Any others found are compiled afterwards.
FFI_ORDER = [
    "cupid/Cupid/Storable.hs",
    "base/Foreign/C/Error.hs",
    "base/Foreign/Marshal/Alloc.hs",
    "base/Foreign/Marshal/Utils.hs",
    "base/Foreign/Ptr.hs",
    "base/System/Posix/Internals.hs",
    "base/System/Posix/Signals.hs",
    "base/System/Process/Internals.hs",
    "base/Data/ByteString/Base.hs",
]

# Modules that only make sense on a POSIX system, left out on Windows,
# where nothing else in the libraries imports them
POSIX_ONLY = [
    "base/System/Posix/Internals.hs",
    "base/System/Posix/Signals.hs",
    "base/System/Process/Internals.hs",
]

PACKAGE_INCLUDE_DIRS = {"base": ["include"], "cupid": ["Cupid"]}


def main(argv):
    if len(argv) != 7:
        raise SystemExit(__doc__)
    srcroot, out, fficupid, mksysconfig, platform_dir, system, stamp = argv
    lib = os.path.join(srcroot, "libraries")
    pkgdir = os.path.join(out, "packages")

    shutil.rmtree(out, ignore_errors=True)
    os.makedirs(os.path.join(out, "include"))
    for p in PACKAGES:
        shutil.copytree(os.path.join(lib, p), os.path.join(pkgdir, p))
    if system == "windows":
        shutil.copytree(os.path.join(lib, "windows"), pkgdir, dirs_exist_ok=True)
        for rel in POSIX_ONLY:
            path = os.path.join(pkgdir, rel)
            os.remove(path)
            try:  # and the directories that held nothing else
                os.removedirs(os.path.dirname(path))
            except OSError:
                pass
    shutil.copy2(os.path.join(srcroot, "src", "HsFFI.h"), os.path.join(out, "include"))

    # Platform-dependent parts, from the compiler
    with open(os.path.join(pkgdir, "base", "include", "HsBaseConfig.h"), "w") as f:
        subprocess.run([mksysconfig, "--header"], stdout=f, check=True)
    with open(os.path.join(pkgdir, "cupid", "Cupid", "SysConfig.hs"), "w") as f:
        subprocess.run([mksysconfig, "--haskell"], stdout=f, check=True)

    # FFI stubs
    ffi_modules = []
    for p in PACKAGES:
        for root, _, files in os.walk(os.path.join(pkgdir, p)):
            for name in sorted(files):
                if name.endswith(".hs"):
                    path = os.path.join(root, name)
                    with open(path, encoding="latin-1") as f:
                        if re.search(r"^\s*foreign\s+import\b", f.read(), re.M):
                            # With "/" whatever the OS, to match FFI_ORDER
                            rel = os.path.relpath(path, pkgdir)
                            ffi_modules.append(rel.replace(os.sep, "/"))
    ordered = [m for m in FFI_ORDER if m in ffi_modules]
    ordered += sorted(m for m in ffi_modules if m not in FFI_ORDER)

    env = dict(os.environ, CUPIDDIR=out)
    search_path = os.pathsep.join(os.path.join(pkgdir, p) for p in PACKAGES)
    for rel in ordered:
        package = rel.split("/")[0]
        pdir = os.path.join(pkgdir, package)
        path = os.path.join(pkgdir, rel)
        with open(path, encoding="latin-1") as f:
            text = f.read()
        cfiles = []
        for m in re.finditer(r"\{-#\s*CFILES\s+(.*?)\s*#-\}", text):
            cfiles += [os.path.join(pdir, c) for c in m.group(1).split()]
        cmd = [fficupid, "-P" + search_path]
        cmd.append(path)
        cmd += ["-I" + os.path.join(pdir, d) for d in PACKAGE_INCLUDE_DIRS.get(package, [])]
        cmd += ["-I" + os.path.join(out, "include"), "-I" + platform_dir]
        cmd += cfiles
        print("fficupid", rel, flush=True)
        subprocess.run(cmd, env=env, check=True)

    with open(stamp, "w"):
        pass


if __name__ == "__main__":
    main(sys.argv[1:])
