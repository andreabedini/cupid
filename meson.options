option('cupiddir', type: 'string', value: '',
       description: 'Directory for the Cupid libraries (default: libdir/cupid)')
option('libraries', type: 'boolean', value: true,
       description: 'Build the Haskell libraries')
option('readline', type: 'feature', value: 'auto',
       description: 'Command-line editing with GNU readline or libedit')
option('char-encoding', type: 'combo', choices: ['utf8', 'locale', 'none'], value: 'utf8',
       description: 'Encoding used for character I/O')

# Feature toggles; each defines one or more macros in config.h
option('profiling', type: 'boolean', value: false,
       description: 'Heap profiler')
option('checks', type: 'boolean', value: false,
       description: 'Developer build: keep assertions, check cell tags at the type checker entry points, add the +D bytecode listing (slower)')
