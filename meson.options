option('hugsdir', type: 'string', value: '',
       description: 'Directory for the Hugs libraries (default: libdir/hugs)')
option('libraries', type: 'boolean', value: true,
       description: 'Build the Haskell libraries (needs a POSIX shell)')
option('readline', type: 'feature', value: 'auto',
       description: 'Command-line editing with GNU readline or libedit')
option('char-encoding', type: 'combo', choices: ['utf8', 'locale', 'none'], value: 'utf8',
       description: 'Encoding used for character I/O')

# Feature toggles; each defines one or two macros in config.h
option('profiling', type: 'boolean', value: false,
       description: 'Heap profiler')
option('timer', type: 'boolean', value: false,
       description: 'Time every evaluation (for benchmarking Hugs itself)')
option('debug-code', type: 'boolean', value: false,
       description: 'Debug generated bytecodes and the interpreter; keeps assertions enabled')
option('tag-checks', type: 'boolean', value: false,
       description: 'Runtime tag checking as an internal consistency check (very slow)')
option('internal-prims', type: 'boolean', value: false,
       description: 'Experimental primitives to access Hugs internals')
option('stack-dumps', type: 'boolean', value: false,
       description: 'Print the objects under evaluation on stack overflow')
option('path-canonicalization', type: 'boolean', value: false,
       description: 'Convert file names to absolute normal form')
option('small-banner', type: 'boolean', value: false,
       description: 'Single-line startup banner')
option('explain-instance-resolution', type: 'boolean', value: false,
       description: 'Enable the :xplain command')
option('dont-panic', type: 'boolean', value: false,
       description: 'Leave fatal signals to the debugger instead of returning to the prompt')
